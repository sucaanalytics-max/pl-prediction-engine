# Never commit real credentials. Configure these as GitHub/Vercel secrets.
ODDS_API_KEY=
SUPABASE_URL=
# Preferred modern backend key. Never expose this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy fallback while existing projects still use JWT service-role keys.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
FPL_ENTRY_ID=20945

# Live season served by the FPL API.
PL_CURRENT_SEASON=2627

# Additional per-event markets consume substantially more Odds API quota.
ODDS_FETCH_ADDITIONAL=false
ODDS_ADDITIONAL_REGIONS=uk
ODDS_ADDITIONAL_HORIZON_HOURS=72

# Experimental until the OOF feature path is fully production-equivalent.
ENABLE_STACKING=false

# Free token from https://www.football-data.org/client/register — used by the
# `matchday` MCP server for development-time football data lookups. Not read by
# the pipeline itself; the daily run must not depend on MCP.
# NOTE: Claude Code expands this from the process environment, not from this file.
# Export it in ~/.zshenv (not ~/.zshrc — that is only sourced by interactive
# shells, so scripts and non-terminal tooling would not see it). See CLAUDE.md.
FOOTBALL_DATA_TOKEN=
