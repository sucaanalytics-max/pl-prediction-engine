# Never commit real credentials. Configure these as GitHub/Vercel secrets.
ODDS_API_KEY=
SUPABASE_URL=
# Preferred modern backend key. Never expose this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy fallback while existing projects still use JWT service-role keys.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
FPL_ENTRY_ID=20945

# Live season served by the FPL API.
PL_CURRENT_SEASON=2627

# Additional per-event markets consume substantially more Odds API quota.
ODDS_FETCH_ADDITIONAL=false
ODDS_ADDITIONAL_REGIONS=uk
ODDS_ADDITIONAL_HORIZON_HOURS=72

# Experimental until the OOF feature path is fully production-equivalent.
ENABLE_STACKING=false

# Free token from https://www.football-data.org/client/register — used by the
# `matchday` MCP server for development-time football data lookups. Not read by
# the pipeline itself; the daily run must not depend on MCP.
# NOTE: Claude Code expands this from the process environment, not from this file.
# Export it in ~/.zshenv (not ~/.zshrc — that is only sourced by interactive
# shells, so scripts and non-terminal tooling would not see it). See CLAUDE.md.
FOOTBALL_DATA_TOKEN=

# ── Grok / xAI, for X (Twitter) team news ────────────────────────────────────
#
# Two routes, and you only need one.
#
# A) GROK_API_KEY — our code calls the xAI API itself, so there is no manual
#    step. From https://console.x.ai. Paste it into `.env` (gitignored), NEVER
#    into a chat window, a commit, or this example file. For the scheduled
#    workflow it must ALSO be a GitHub repository secret:
#    Settings -> Secrets and variables -> Actions -> New repository secret.
#
#    This is a metered API and the £0 connector budget stops applying the moment
#    it is set. At the agent's 3-hourly cadence that is 8 calls a day.
GROK_API_KEY=
# Model to ask. Live X search is what this connector is for, so it needs a model
# with search enabled.
GROK_MODEL=grok-4-latest

# B) GROK_FEED_URL — a published Google Sheet or JSON file that YOU keep
#    updated, read over plain HTTP with no key and no cost. Set this INSTEAD of
#    GROK_API_KEY if you would rather review every row before the model sees it.
#    Schema and the prompt: docs/grok-x-feed-schema.md
GROK_FEED_URL=
