# Next.js reads .env from THIS directory, not the repository root — so the root
# .env is invisible here. Without the entry id below, every squad-backed screen
# renders "Manager ID unavailable" and "No squad could be read", which looks like
# a bug and is not one. Copy this file to `.env.local` to develop locally.

# The FPL manager whose squad the app describes.
NEXT_PUBLIC_FPL_ENTRY_ID=20945

# Optional. When set, artifacts are read from Supabase Storage and fall back to
# the committed copies under public/predictions on any failure. Leave unset to
# read the committed copies only — which is the normal local setup.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
