<?xml version="1.0" encoding="UTF-8"?>
<!--
  Twice-daily X scan.

  Install:
      cp scripts/com.pl-prediction.x-scan.plist ~/Library/LaunchAgents/
      launchctl load ~/Library/LaunchAgents/com.pl-prediction.x-scan.plist

  Check it is registered:
      launchctl list | grep pl-prediction

  Run it once, now, without waiting for the schedule:
      launchctl start com.pl-prediction.x-scan

  Remove:
      launchctl unload ~/Library/LaunchAgents/com.pl-prediction.x-scan.plist

  ## Why launchd rather than a Claude session

  A CronCreate schedule inside Claude Code dies when the session exits and expires
  after seven days. A LaunchAgent survives both, and reboots.

  ## What it cannot do

  It needs the Mac awake and the user logged in — a LaunchAgent runs in the user's
  session, not as a system daemon. `StartCalendarInterval` fires a missed run when
  the machine wakes, so a closed lid delays the scan rather than losing it, but a
  machine off all day scans nothing.

  That is a real limit of this route and the reason the logged-out page's five-post
  window matters: a scan missed for two days loses the posts in between. The RSS
  feeds in `news.yml` keep running in CI regardless.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pl-prediction.x-scan</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/tusk-jvb/dev/pl-prediction-engine/scripts/x_scan.sh</string>
    </array>

    <!-- 07:17 and 19:17 local. Off the :00 and :30 marks deliberately: nothing
         here needs a round number, and the odd minute keeps this off the same
         instant as every other scheduled job on the machine. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key><integer>7</integer>
            <key>Minute</key><integer>17</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>19</integer>
            <key>Minute</key><integer>17</integer>
        </dict>
    </array>

    <!-- The repo moved out of ~/Documents on 2026-08-13, because iCloud's File
         Provider was producing conflict copies and had begun corrupting .git.
         These two paths were not updated with it, and that is exactly how this
         job died: launchd fired it twice daily for three weeks and bash wrote
         "Operation not permitted" into a log nobody reads, while x_inbox.csv
         quietly stopped at 2026-08-16. `x_scan.sh` derives its own repo root
         precisely so this cannot happen to IT; the plist had no such defence.
         Absolute paths are unavoidable in a LaunchAgent, so the remedy is that
         the failure is now documented where the next person will look. -->
    <key>WorkingDirectory</key>
    <string>/Users/tusk-jvb/dev/pl-prediction-engine</string>

    <!-- Logs, so a failed scan can be read after the fact rather than guessed at.
         The script prints a UTC timestamp per line for exactly this. -->
    <key>StandardOutPath</key>
    <string>/Users/tusk-jvb/Library/Logs/pl-prediction-x-scan.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/tusk-jvb/Library/Logs/pl-prediction-x-scan.log</string>

    <!-- Do NOT run at load. Loading the agent should not fire a scan and a push as
         a side effect of installing it. -->
    <key>RunAtLoad</key>
    <false/>

    <!-- launchd starts with a minimal PATH; the script also sets its own, but this
         covers anything invoked before that line. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>

        <!-- The scan's OWN browser profile, not the everyday Chrome.
             Measured 2026-09-04: a logged-out browser gets
             `net::ERR_HTTP_RESPONSE_CODE_FAILURE` from x.com, so the anonymous
             route this job used for its whole life returns nothing. It needs a
             signed-in session.

             Not the daily-driver profile, for two reasons. chrome://inspect's
             remote-debugging toggle is scoped to a debugging session and the
             port keeps listening after it ends — so the endpoint looks alive,
             404s on the browser id, and a 07:17 job would fail silently, which
             is how this lane already lost three weeks. And pointing
             --remote-debugging-port at a signed-in daily profile hands any
             local process control of every logged-in site, not just X.

             `scripts/scan_browser.sh` owns this profile and x_scan.sh starts it.
             It is signed into X once, by hand, and carries nothing else. -->
        <key>X_SCAN_CHROME_PROFILE</key>
        <string>/Users/tusk-jvb/Library/Application Support/pl-prediction-x-scan</string>
    </dict>

    <!-- One scan at a time. Two overlapping runs would race on the inbox and on
         the git index. -->
    <key>AbandonProcessGroup</key>
    <false/>
</dict>
</plist>
